# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL on separate host)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_subscription_store?schema=public"

# CORS (must match the browser Origin exactly; no trailing slash)
# Set this in the Liara dashboard too — local .env is not deployed.
# Multiple origins: https://app.example.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT
USER_JWT_SECRET=change-me-user-jwt-secret-min-32-chars
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
USER_JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h

# Encryption (AES-256-GCM, 32-byte key as hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Wallet API
WALLET_API_BASE_URL=https://wallet.example.com/api
WALLET_API_TOKEN=your-wallet-api-token
WALLET_CALLBACK_URL=http://localhost:5173/payment/result

# MeliPayamak SMS
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM_NUMBER=

# Admin seed (used by prisma/seed.ts)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_FULL_NAME=مدیر سیستم
