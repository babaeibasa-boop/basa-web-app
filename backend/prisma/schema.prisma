generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AiModel {
  CHATGPT
  CLAUDE
  GEMINI
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model User {
  id          String   @id @default(cuid())
  walletId    String   @unique
  phone       String   @unique
  name        String
  family      String
  walletToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders           Order[]
  voucherPurchases VoucherPurchase[]

  @@index([phone])
  @@map("users")
}

model Order {
  id                   String      @id @default(cuid())
  userId               String
  aiModel              AiModel
  selectedPlan         String
  selectedPlanUsdValue Float
  status               OrderStatus @default(PENDING_PAYMENT)
  encryptedCredentials String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model Invoice {
  id              String        @id @default(cuid())
  orderId         String
  amount          BigInt
  status          InvoiceStatus @default(PENDING)
  paymentTrackId  String?
  paymentToken    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  phones AdminPhone[]

  @@map("admins")
}

model AdminPhone {
  id      String @id @default(cuid())
  adminId String
  phone   String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_phones")
}

enum VoucherStatus {
  AVAILABLE
  RESERVED
  SOLD
  CANCELLED
}

enum VoucherPurchaseStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

model VoucherPlatform {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String
  encryptedApiKey String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vouchers Voucher[]

  @@map("voucher_platforms")
}

model Voucher {
  id            String        @id @default(cuid())
  platformId    String
  amount        BigInt
  duration      String
  expiresAt     DateTime
  encryptedCode String
  status        VoucherStatus @default(AVAILABLE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  platform VoucherPlatform  @relation(fields: [platformId], references: [id], onDelete: Cascade)
  purchase VoucherPurchase?

  @@index([platformId])
  @@index([status])
  @@index([expiresAt])
  @@index([platformId, amount, duration, status])
  @@map("vouchers")
}

model VoucherPurchase {
  id             String                @id @default(cuid())
  userId         String
  voucherId      String                @unique
  amount         BigInt
  status         VoucherPurchaseStatus @default(PENDING_PAYMENT)
  paymentTrackId String?
  paymentToken   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([paymentTrackId])
  @@map("voucher_purchases")
}
